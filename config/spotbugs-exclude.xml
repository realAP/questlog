<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">
  <!-- Reiner Hinweis von FindSecBugs, dass ein Controller erreichbar ist; keine Schwachstelle. -->
  <Match>
    <Bug pattern="SPRING_ENDPOINT"/>
  </Match>
  <!-- Tests verwenden feste Testzugangsdaten. -->
  <Match>
    <Class name="~.*Test"/>
    <Bug pattern="HARD_CODE_PASSWORD"/>
  </Match>
</FindBugsFilter>
